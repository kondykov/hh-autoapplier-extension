POSTGRES_PASSWORD=change-me
# Расширение входит по персональному токену hh_… (POST /api/tokens после входа по паролю) — общего ключа нет (#42)
# Первый администратор: создаётся при старте, пока администраторов нет. Пароль — не короче 10 символов.
# ВНИМАНИЕ: пароль в .env лежит открытым текстом. После первого старта сменить его (POST /api/auth/password в /scalar) и очистить ADMIN_PASSWORD;
# ADMIN_EMAIL оставить — ему переходят данные без владельца. На сервере .env не хранить в репозитории и бэкапах
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Сбор с публичных страниц hh.ru (без токена и аккаунта)
HH_ENABLED=true
COLLECT_INTERVAL_MINUTES=60
DB_PORT=5433
# LLM с OpenAI-совместимым API; по умолчанию Groq (ключ: https://console.groq.com/keys). Пустой ключ — LLM выключена
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_DAILY_LIMIT=300

# Чужие источники для CORS через запятую (например chrome-extension://<id>); пусто — CORS выключен, расширению он не нужен
CORS_ORIGINS=
# Telegram-бот (токен от @BotFather); пусто — бот выключен. Привязка чата: POST /api/telegram/link после входа по паролю → /start <код>
TELEGRAM_BOT_TOKEN=
