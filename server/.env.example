POSTGRES_PASSWORD=change-me
API_KEY=change-me-long-random-string
# Сбор с публичных страниц hh.ru (без токена и аккаунта)
HH_ENABLED=true
COLLECT_INTERVAL_MINUTES=60
DB_PORT=5433
# LLM с OpenAI-совместимым API; по умолчанию Groq (ключ: https://console.groq.com/keys). Пустой ключ — LLM выключена
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_DAILY_LIMIT=300
